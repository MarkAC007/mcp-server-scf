{
  "$comment": "Verdict map for scripts/api-coverage.mjs. Key = METHOD + OpenAPI path. verdict: in | deferred | out. Reasons for out: auth-unreachable, identity-admin, infra-admin, binary-transport, ui-only, deprecated, covered, public. Every deferred row's note names its promotion trigger. Policy: docs/tool-scope.md.",
  "reasons": {
    "auth-unreachable": "An org-scoped user API key cannot reach it (platform-admin session, consultant relationship, OIDC, HMAC, Stripe).",
    "identity-admin": "Membership, invites, API keys, organisation lifecycle — access decisions a person makes in the UI.",
    "infra-admin": "Storage, catalog import/upgrade, database, task queues, integrations — operator work.",
    "binary-transport": "Multipart uploads, byte streams, pre-signed URLs — not a text transport.",
    "ui-only": "Exists to serve a web page: preferences, page-load exports, form feedback, computed scores the UI assembles.",
    "deprecated": "The platform marks it a deprecated alias.",
    "covered": "An existing tool already serves the need through another route or parameter.",
    "public": "Unauthenticated; not organisation work."
  },
